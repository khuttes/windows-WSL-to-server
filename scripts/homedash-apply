#!/usr/bin/env python3
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


POLICY = Path("/var/lib/homedash/policy.json")
TASK_DIR = Path("/opt/homedash/tasks")
CRON_FILE = Path("/etc/cron.d/homedash")
ALLOWED_SERVICES = {"cron", "unattended-upgrades"}
TASK_NAME = re.compile(r"[a-z0-9-]{1,48}\Z")
TASK_SCRIPT = re.compile(r"[a-z0-9_.-]{1,64}\.sh\Z")
CRON_FIELD = re.compile(r"[0-9*/,-]+\Z")
MEMORY_LIMIT = re.compile(r"(?:[1-9][0-9]{0,5}[KMG]|infinity)\Z")
CPU_QUOTA = re.compile(r"(?:[1-9][0-9]{0,3})%\Z")


def validate(policy):
    if not isinstance(policy, dict) or set(policy) != {"services", "limits", "tasks"}:
        raise ValueError("Policy must contain only services, limits, and tasks.")
    if not isinstance(policy["services"], dict) or not isinstance(policy["limits"], dict):
        raise ValueError("Services and limits must be objects.")
    if not isinstance(policy["tasks"], list):
        raise ValueError("Tasks must be an array.")

    for service, state in policy["services"].items():
        if service not in ALLOWED_SERVICES or not isinstance(state, str) or state not in {"running", "stopped"}:
            raise ValueError(f"Unsupported service setting: {service}.")
    for service, limits in policy["limits"].items():
        if service not in ALLOWED_SERVICES or not isinstance(limits, dict):
            raise ValueError(f"Unsupported service limit: {service}.")
        if set(limits) != {"MemoryMax", "CPUQuota"}:
            raise ValueError(f"Invalid limit fields for {service}.")
        if not isinstance(limits["MemoryMax"], str) or not MEMORY_LIMIT.fullmatch(limits["MemoryMax"]):
            raise ValueError(f"Invalid MemoryMax for {service}.")
        if not isinstance(limits["CPUQuota"], str) or not CPU_QUOTA.fullmatch(limits["CPUQuota"]):
            raise ValueError(f"Invalid CPUQuota for {service}.")

    cron_lines = []
    for task in policy["tasks"]:
        if not isinstance(task, dict) or set(task) != {"name", "cron", "script"}:
            raise ValueError("Each task must contain only name, cron, and script.")
        name, schedule, script = task["name"], task["cron"], task["script"]
        if not isinstance(name, str) or not TASK_NAME.fullmatch(name):
            raise ValueError("Invalid task name.")
        if not isinstance(schedule, str) or len(schedule) > 100:
            raise ValueError(f"Invalid schedule for task {name}.")
        fields = schedule.split()
        if len(fields) != 5 or any(not CRON_FIELD.fullmatch(field) for field in fields):
            raise ValueError(f"Invalid five-field cron schedule for task {name}.")
        if not isinstance(script, str) or not TASK_SCRIPT.fullmatch(script):
            raise ValueError(f"Invalid script name for task {name}.")
        script_path = TASK_DIR / script
        if not script_path.is_file():
            raise ValueError(f"Task script does not exist: {script}.")
        metadata = script_path.lstat()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_mode & 0o022
        ):
            raise ValueError(f"Task script must be root-owned and not group/world writable: {script}.")
        cron_lines.append(f"{schedule} root /bin/sh {script_path}")
    return cron_lines


def run(*arguments):
    result = subprocess.run(arguments, capture_output=True, text=True, timeout=15, check=False)
    if result.returncode:
        detail = (result.stderr or result.stdout).strip()
        raise RuntimeError(detail or f"{arguments[0]} failed with exit code {result.returncode}.")


def replace_cron_file(contents):
    descriptor, temporary = tempfile.mkstemp(prefix=".homedash-", dir=CRON_FILE.parent, text=True)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            file.write(contents)
        os.chown(temporary, 0, 0)
        os.chmod(temporary, 0o644)
        os.replace(temporary, CRON_FILE)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def main():
    if os.geteuid() != 0:
        raise PermissionError("This helper must be run as root.")
    policy = json.loads(POLICY.read_text(encoding="utf-8"))
    cron_lines = validate(policy)

    for service, state in policy["services"].items():
        run("systemctl", "start" if state == "running" else "stop", service + ".service")
    for service, limits in policy["limits"].items():
        run(
            "systemctl",
            "set-property",
            service + ".service",
            "MemoryMax=" + limits["MemoryMax"],
            "CPUQuota=" + limits["CPUQuota"],
        )
    replace_cron_file("\n".join(cron_lines) + ("\n" if cron_lines else ""))
    print("OK: policy applied")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"REJECTED: {error}", file=sys.stderr)
        sys.exit(1)
